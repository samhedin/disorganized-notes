(defn checked-text [text]
  (m/Row
   .children [(m/Checkbox
               .value true
               .onChanged (fn [_])
               .activeColor m/Colors.green)
              (f/widget
                 :get {{tthm .-textTheme} m/Theme}
                 m/Expanded
                 (m/Text text
                         .style (.-titleLarge tthm)))]))

(defn feature-row [icon text tthm]
  (m/Row
   .mainAxisSize m/MainAxisSize.min
   .children [(m/Icon icon .size 26)
              (m/SizedBox .width 14)
              (m/Text text
                      .style (.-titleMedium tthm))]))

(defn web-notice []
  (f/widget
   :get {{tthm .-textTheme} m/Theme}
   (m/Center
    .child
    (m/Card
     .elevation 0
     .child
     (m/SizedBox
      .width 350
      .child 
      (f/widget
       :padding {:vertical 8}
       (m/Column
        .mainAxisSize m/MainAxisSize.min
        .mainAxisAlignment m/MainAxisAlignment.center
        .children
        [(m/Text "Premium required for web!"
                 .style (.-titleLarge tthm))
         (m/SizedBox .height 8)
         (m/Text "Get premium via one of the mobile apps
then sign in with the same account.")
         (m/SizedBox .height 8)
         (m/Row
          .mainAxisAlignment m/MainAxisAlignment.center
          .children
          [(m/OutlinedButton
            .child (m/Text "iOS app")
            .onPressed (fn []
                         (url/launch "https://apps.apple.com/us/app/disorganized-notes-todo/id6738280174")
                         nil))
           (m/SizedBox .width 12)
           (m/OutlinedButton
            .child (m/Text "Android app")
            .onPressed (fn []
                         (url/launch "https://play.google.com/store/apps/details?id=com.disorganized.disorganized&pli=1&gl=cn")
                         nil))])])))))))

(defn redirect [ctx]
  (-> ctx
      go_router/GoRouterHelper
      (.go
       "/"))
  nil)

(defn redirect-to-first-note
  "Onboarding landing for a *brand new* account, however it was created —
  Get started (anonymous) or registering outright. Both get the identical
  seeded welcome note; `via` only records which door they came through.
  Existing users upgrading an anonymous account already have notes: send them
  through `redirect` instead, or they get a second welcome note."
  [ctx via]
  (println "redirecting")
  ;;Seed a starter note (structure + a short checklist) instead of a blank page,
  ;;so the first thing a new user sees demonstrates how notes work.
  (let [note (ex/welcome)]
    (rd/dispatch [::model/upload-note  [note true]])
    (rd/dispatch [::model/refresh-notes])
    ;;The welcome note is seeded, not user-created — funnel counts the first
    ;;*real* note elsewhere (see the note-count watcher in read/list-notes).
    (utils/log-analytics "onboarding_welcome_seeded" {"via" via})
    (rd/dispatch [::model/set-new-plaintext (:plaintext note)])
    (rd/dispatch [::model/set-key :override-title (str (:title note))])
    (-> ctx
        go_router/GoRouterHelper
        (.go
         "/"))

    ;;The seeded welcome note (checklist + structure) is now the onboarding, so
    ;;we skip the old :first-launch? overlay coaching (tag hint, clone highlight)
    ;;— it would just duplicate the checklist.
    (-> ctx go_router/GoRouterHelper
        (.pushNamed "edit"
                    .pathParameters {"id" (:id note)}
                    .extra {:autofocus false
                            :first-launch? false}))
    nil))


(def ^m/Widget build-first-note
  (f/build
   [^go_router/GoRouterState router-state]
   (m/Scaffold
    .body
    (f/widget
     :watch [prefs (rd/subscribe [::model/get-user-options])]
     :get {{tthm .-textTheme} m/Theme}
     :get [m/ScaffoldMessenger]
     :context ctx
     :padding {:top 24
               :horizontal 24}
     :watch [brightness (rd/subscribe [::model/get-brightness])
             selected-notes (atom #{}) :as *selected-notes]
     :let [uid? (model/uid)]
     :bg-watcher ([{uid .-uid} (.authStateChanges FirebaseAuth.instance)]

                  
                  (when uid
                    (-> ctx
                        go_router/GoRouterHelper
                        (.go
                         "/"))))
     m/SafeArea
     m/Column
     .children
     (concat
      [(m/SizedBox .height 24)
       (m/Center
        .child (m/Text "Disorganized"
                       .style (.-headlineLarge tthm)))

       (f/widget
        :padding {:top 8}
        m/Center
        (m/Text "One place for your lists, tables, reminders and more."
                .textAlign m/TextAlign.center
                .style (.-titleMedium tthm)))

       (f/widget
        :padding {:top 32}
        m/Center
        (m/Column
         .mainAxisSize m/MainAxisSize.min
         .crossAxisAlignment m/CrossAxisAlignment.start
         .children
         [(feature-row m/Icons.post_add "Build notes from sections" tthm)
          (m/SizedBox .height 16)
          (feature-row m/Icons.tag "Find anything with tags" tthm)
          (m/SizedBox .height 16)
          (feature-row m/Icons.copy_all "Reuse notes as templates" tthm)

          (f/widget
           :padding {:top 36}
           m/Center
           (m/ElevatedButton
            .onPressed (fn []
                         (utils/log-analytics "welcome_get_started_clicked")
                         (await (FirebaseAuth.instance.signInAnonymously))
                         (user-created nil)
                         (redirect-to-first-note ctx "get_started"))

            .child (f/widget
                    :padding {:horizontal 20
                              :vertical 12}
                    (m/Text "Get started"
                            .style (.-titleLarge tthm)))))]))

       (m/Spacer)
       (f/widget
        :padding {:bottom 20}
        (m/Align
         .alignment m/Alignment.bottomLeft)
        (m/ElevatedButton
         .onPressed
         (fn []
           (-> ctx go_router/GoRouterHelper
               (.go
                "/login"))
           nil)
         .child (m/Text "I've used this app before")))])))))



(defn register-sign-up []
  (f/widget
   :context ctx
   :get {{tthm .-textTheme} m/Theme}
   (m/Row
    .children
    [(m/Expanded
      .child (f/widget
              :padding {:horizontal 20}
              (m/ElevatedButton.icon
               .icon (m/Icon m/Icons.login)
               .label
               (f/widget
                :padding {:vertical 10}
                (m/Text "Sign in/Register"))

               .onPressed (fn []
                            (-> ctx go_router/GoRouterHelper
                                (.go
                                 "/login"))
                            nil))))])))

(defn user-created [prefs]
  (rd/dispatch [::model/update-user-options {"registered_at" (DateTime.now)}])
  (rd/dispatch [::model/update-user-options (or prefs {})])
  (utils/log-analytics "user_created"))

(def ^m/Widget login
  (f/build
   [^go_router/GoRouterState router-state]
   (m/Scaffold
    .appBar (m/AppBar)
    .body
    (f/widget
     :watch [prefs (rd/subscribe [::model/get-user-options])]
     :get {{tthm .-textTheme} m/Theme}
     :get [m/ScaffoldMessenger m/Navigator]
     :let [uid? (model/uid)]
     :context ctx
     ;; :bg-watcher ([{uid .-uid} (.authStateChanges FirebaseAuth.instance)]
     ;;              (when uid
     ;;                     (rd/dispatch [::model/refresh-notes])
     ;;                     (rd/dispatch [::model/fetch-user-options])
     ;;                     (await (model/init-revenuecat- uid))

     ;;                (-> ctx go_router/GoRouterHelper
     ;;                    (.goNamed "root"))))

     (if (not uid?)
       (uia/SignInScreen
        ;;No "Skip registration" here any more. It signed the user in
        ;;anonymously and seeded the welcome note — exactly what Get started on
        ;;the previous screen does — so it was a second door onto the same
        ;;path. Users who arrive here without an account go back and use Get
        ;;started; this screen is now only for people who really do have one.
        .sideBuilder (fn [_ _]
                       (if (or kDebugMode (not kIsWeb))
                         (m/SizedBox.shrink)
                         (web-notice)))

        .headerBuilder
        (fn [_ _ _]
          (if (or kDebugMode (not kIsWeb))
            (m/SizedBox.shrink)
            (web-notice)))

        .footerBuilder
        (fn
          [_ _]
          (m/Column
           .children
           [(m/Text "Create an account to back up and sync your notes between devices."
                    .style (.-bodyLarge tthm))]))

        .providers (concat [(uia/EmailAuthProvider)
                            (GoogleProvider
                             .clientId
                             (if (and (not kIsWeb)
                                      Platform.isIOS)
                               "989769042149-46c4m1b144k01fdav1lf49h7redkc2gc.apps.googleusercontent.com"
                               "989769042149-e3onm9bvou4g08c8b9s6lu8h7341ro8b.apps.googleusercontent.com"))]
                           (when (or kIsWeb Platform.isIOS)
                             [(AppleProvider)]))
        .actions
        [(#/(uia/AuthStateChangeAction uia/UserCreated)
          (fn [context state]
            (user-created prefs)
            ;;No uid before this, so the account is brand new — it gets the same
            ;;seeded welcome note as Get started.
            (redirect-to-first-note context "registration")

            nil))

         (#/(uia/AuthStateChangeAction uia/CredentialLinked)
          (fn [context state]
            (await (utils/init-revenuecat- (model/uid)))
            (redirect  ctx)))

         (#/(uia/AuthStateChangeAction uia/SignedIn)
          (fn [context state]
            (redirect  ctx)))]

        .showPasswordVisibilityToggle true)

       (uia/SignInScreen
        .footerBuilder
        (fn
          [_ _]
          (m/Column
           .children
           [(m/Text "Create an account to back up and sync your notes between devices."
                    .style (.-bodyLarge tthm))]))

        .providers (concat [(uia/EmailAuthProvider)
                            (GoogleProvider
                             .clientId
                             (if (and (not kIsWeb)
                                      Platform.isIOS)
                               "989769042149-46c4m1b144k01fdav1lf49h7redkc2gc.apps.googleusercontent.com"
                               "989769042149-e3onm9bvou4g08c8b9s6lu8h7341ro8b.apps.googleusercontent.com"))]
                           (when (or kIsWeb Platform.isIOS)
                             [(AppleProvider)]))
        .actions
        [(#/(uia/AuthStateChangeAction uia/UserCreated)
          (fn [context state]
            (user-created prefs)
            ;;This branch only runs with a uid already present, i.e. an
            ;;anonymous user upgrading. They have notes already — seeding here
            ;;would hand them a second welcome note.
            (redirect ctx)))

         (#/(uia/AuthStateChangeAction uia/CredentialLinked)
          (fn [context state]
            (await (utils/init-revenuecat- (model/uid)))
            (redirect ctx)))

         (#/(uia/AuthStateChangeAction uia/SignedIn)
          (fn [context state]
            (redirect ctx)))]

        .showPasswordVisibilityToggle true))))))

