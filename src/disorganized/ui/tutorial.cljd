(ns disorganized.ui.tutorial
  (:require [disorganized.messaging :as messaging]
            [disorganized.import.import :as import]
            ["package:go_router/go_router.dart" :as go_router :refer [GoRouter GoRoute GoRouterState GoRouterHelper]]
            [disorganized.examples :as ex]
            ["package:url_launcher/url_launcher.dart" :as url]
            ["package:flutter/foundation.dart" :refer [kIsWeb]]
            ["dart:io" :refer [Platform]]
            ["package:awesome_notifications/awesome_notifications.dart" :as notif :refer [AwesomeNotifications ReceivedAction]]
            ["package:cloud_functions/cloud_functions.dart" :refer [FirebaseFunctions]]
            ["package:shared_preferences/shared_preferences.dart" :as sp]
            ["package:disorganized_notes/utils.dart" :as dutils]
            ["package:firebase_auth/firebase_auth.dart" :as firebase-auth :refer [FirebaseAuth]]
            [cljd.flutter :as f]
            [hti.re-dash.alpha :as rd]
            ["package:flutter/material.dart" :as m]
            [disorganized.model :as model]))

(defn dropdown-widget [text]
  (f/widget
   :get {{tthm .-textTheme} m/Theme}
   :padding {:horizontal 24
             :vertical 12}
   (m/Align .alignment m/Alignment.bottomLeft)
   (m/Text text
           .style (.-bodyLarge tthm))))

(defn zen-of-disorganized-child [icon title-text description tthm]
  (f/widget
   :let [size (.-titleMedium tthm)]

   (m/Card
    .elevation 0.0
    .child
    (m/ExpansionTile
     .title
     (m/ListTile
      .title (m/Text title-text
                     .style size)
      .leading (m/Icon icon))
     .children [(dropdown-widget description)]))))

(defn tutorial-chapter [title icon text tthm]
  [(m/ListTile
    .title (m/Text title
                   .style (.-titleLarge tthm))
    .leading (m/Icon icon))

   (f/widget
    :padding {:horizontal 12}
    (m/Align
     .alignment m/Alignment.bottomLeft)
    (m/Text text
            .style (.-bodyLarge tthm)))
   (m/SizedBox .height 12)])

(defn tutorial-dropdown []
  (f/widget
   :get {{tthm .-textTheme} m/Theme}
   :padding {:horizontal 4}
   (m/Card
    .elevation 4
    .child
    (m/ExpansionTile
     .title
     (m/ListTile
      .title
      (m/Text "Every note is a template"
              .style (.-titleLarge tthm)))
     .children
     [(f/widget
       :padding {:horizontal 12}
       (m/Align
        .alignment m/Alignment.bottomLeft)
       (m/Text "Many notes are similar to each other and that's where cloning can save you time.

If you have a recipe note with a table of ingredients, you can clone it to quickly create a new note with the same table."
               .style (.-bodyLarge tthm)))
      (m/SizedBox .height 12)
      (f/widget
       :padding {:horizontal 12
                 :bottom 12}
       (m/Row
        .children [(m/Text "Clone icon: ")
                   (m/Icon m/Icons.copy_all)]))]))))

(defn zen-of-disorganized [tthm]

  [(zen-of-disorganized-child
    m/Icons.post_add
    "Build with sections"
    "Build your note using sections. For example, to make a recipe you could add a table of ingredients and a cooking timer."

    tthm)

   (m/SizedBox .height 4)
   (zen-of-disorganized-child
    m/Icons.tag
    "Organize with tags"
    "Tags help you find your note later.
If you're writing a recipe, add a recipe tag!"
    tthm)

   (m/SizedBox .height 4)
   (zen-of-disorganized-child
    m/Icons.copy_all
    "Reuse with cloning"
    "Many notes are similar to each other. 
For example, most recipes have a table of ingredients. 

Instead of recreating the table for each recipe, just clone an old recipe and its sections and tags will be copied to a new note."
    tthm)])

(defn example-notes-popup [large?]
  (f/widget
   :managed [gk (m/GlobalKey) :dispose nil]
   :context ctx
   :get {{tthm .-textTheme} m/Theme}

   (m/PopupMenuButton
    .key gk
    .child (m/ElevatedButton.icon
            .label (f/widget
                    :padding {:horizontal (if large? 4 0)
                              :vertical (if large? 4 0)}
                    (if large?
                      (m/Text "Starting notes"
                              .style (.-titleLarge tthm))
                      (m/Text "Starting notes")))

            .icon (m/Icon m/Icons.auto_stories)
            .onPressed (fn []
                         (.showButtonMenu (.-currentState gk))))
    .itemBuilder
    (fn [_]
      #dart ^m/PopupMenuEntry
       [(m/PopupMenuItem
         .value "recipe"
         .child (m/ListTile
                 .title (m/Text "Recipe (cloning explained)")
                 .trailing (m/Icon m/Icons.copy_all)))

        (m/PopupMenuItem
         .value "groceries"
         .child (m/ListTile
                 .title (m/Text "Shopping list")))

        (m/PopupMenuItem
         .value "workout"
         .child (m/ListTile
                 .title (m/Text "Gym workout")))

        (m/PopupMenuItem
         .value "todo"
         .child (m/ListTile
                 .title (m/Text "A few things to try!")))

;; (m/PopupMenuItem
       ;;  .value "love-letter"
       ;;  .child (m/ListTile
       ;;          .title (m/Text "Love letter")))
        ])

    .onSelected (fn [selection]
                  (if (= "import" selection)
                    (import/import-note-popup ctx)
                    (let [note (case selection
                                 "groceries" (ex/groceries)
                                 "todo" (ex/todo)
                                 "workout" (ex/workout)
                                        ;                                 "love-letter" (ex/love-letter)
                                 "recipe" (ex/recipe))]
                      (rd/dispatch [::model/upload-note [note true]])
                      (rd/dispatch [::model/refresh-notes])
                      (rd/dispatch [::model/set-new-plaintext (:plaintext note)])
                      (rd/dispatch [::model/set-key :override-title (str (:title note))])
                      (rd/dispatch [::model/set-current-note-id (:id note)])))))))

(defn longest-consecutive [bools]
  (first
   (reduce (fn [[longest current] v]
             (if v
               (let [current (inc current)]
                 [(max longest current) current])
               [longest 0]))
           [0 0]
           bools)))

(defn user-younger-than?
  [days]
  (boolean
   (when-let [user? (-> FirebaseAuth .-instance .-currentUser)]
     (.isAfter
      (-> user? .-metadata .-creationTime)
      (.subtract (DateTime.now) (Duration .days days))))))

(defn recent-user?
  []
  (when-let [user? (-> FirebaseAuth .-instance .-currentUser)]
    (.isAfter
     (-> user? .-metadata .-creationTime)
     (.subtract (DateTime.now) (Duration .days 12)))))

(defn days-since-registration []
  (when-let [user? (-> FirebaseAuth .-instance .-currentUser)]
    (.inDays (.difference  (DateTime.now) (-> user? .-metadata .-creationTime)))))

;;Number of daily-cadence notes in a row needed to unlock the premium reward.
;;Shared by the gate (user-can-claim-premium?) and the home-screen progress
;;banner so the two never drift apart.
(def streak-goal 4)

(defn consecutive-notes [saved-notes]
  (let [dates (sort (mapv :created_at (filter #(nil? (:default %))
                                              saved-notes)))
        ;;The user shouldn't be able to just spam 5 notes straight away.
        ;;There needs to be some habit to it.
        good-distance-to-last-note
        (map-indexed
         (fn [i date]
           (if (= 0 i)
             true
             (let [last-date (nth dates (dec i))]
               (and (.isBefore date (.add last-date (Duration .hours 48)))
                    (.isAfter date (.add last-date (Duration .hours 7)))))))
         dates)]
    (longest-consecutive good-distance-to-last-note)))

(defn streak-progress
  "Streak shown to the user: the real daily-note streak (consecutive-notes, which
  excludes the :default welcome note) plus a day-1 credit for the seeded welcome
  note. Gives new users an endowed-progress head start (\"1 of 4\") without letting
  the seeded note distort the cadence math. Used for both the banner and the
  claim gate so the two stay in sync."
  [saved-notes]
  (min streak-goal
       (+ (consecutive-notes saved-notes)
          (if (some :welcome saved-notes) 1 0))))

(defn user-can-claim-premium? [saved-notes]
  (when (recent-user?)
    (or (>= (streak-progress saved-notes) streak-goal)
        (some :imported saved-notes))))

(defn cancel-streak-reminders []
  (await (.cancelSchedulesByChannelKey (notif/AwesomeNotifications) "habit_channel")))

(defn premium-offer [scaffold-messenger ctx]
  (m/ElevatedButton.icon
   .onPressed (fn []
                (model/snackbar scaffold-messenger "Setting premium...")
                (model/log-analytics "premium_claim_attempt")
                (await
                 (if (or kIsWeb Platform.isAndroid)
                   (let [output (await
                                 (.call
                                  (FirebaseFunctions.instance.httpsCallable "grant_n_months")
                                  (dutils/stringKeys {"uid" (model/uid)
                                                      "duration" 3})))
                         status (get (.-data output) "status")]

                     (if (= "success" status)
                       (do
                         (await (model/restore-purchase))
                         (await (cancel-streak-reminders))
                         (model/log-analytics "premium_claimed")
                         (model/snackbar scaffold-messenger "You have premium!"))

                       (do
                         ;;Note: analytics values can't contain "-", so map the status.
                         (model/log-analytics "premium_claim_failed"
                                              {"reason" (if (= "too-old" status) "too_old" "error")})
                         (model/snackbar
                          scaffold-messenger
                          (case status
                            "too-old" "Account older than 12 days, please contact support."
                            "Something went wrong, please contact support and include your user id (found in settings).")))))

                   ;;Apple toc forbids us from adding premium in any other way than this.
                   (do
                     (model/log-analytics "premium_redeem_opened")
                     (url/launch (str "https://apps.apple.com/redeem?ctx=offercodes&id=6738280174&code=THREEMONTHS"))
                     (await (model/restore-purchase))
                     (await (cancel-streak-reminders))
                     (model/snackbar scaffold-messenger "Open settings and click Sync premium access after signing up"))))

                nil)
   .icon (m/Icon m/Icons.workspace_premium)
   .label (m/Text "Click here for 3 months premium!")))

;;Daily nudges that build toward the premium streak reward (see
;;user-can-claim-premium? and the home-screen progress banner). We schedule one
;;per day for the streak window so returning each day keeps the streak alive.
;;Copy reflects the streak at scheduling time; since we reschedule every time a
;;new note is created (refresh-streak-reminders), it stays roughly in sync.
(defn streak-reminders [streak]
  (let [remaining (max 1 (- streak-goal streak))
        days (fn [n] (str n (if (= 1 n) " day" " days")))]
    [{:id 0
      :hours 24
      :title "Keep your streak going"
      :body (str "You're " streak " of " streak-goal " days in. Add a note today to earn 3 months of premium.")}
     {:id 1
      :hours 48
      :title "Don't lose your streak"
      :body (str "Just " (days remaining) " of notes to go for 3 months of premium.")}
     {:id 2
      :hours 72
      :title "Almost there"
      :body (str "You're closing in on " streak-goal " days. Make a note to claim your premium.")}]))

;;Cancels any outstanding reminders and reschedules them from the current streak,
;;unless the reward is already earned/unlocked (cancel-on-claim) or notifications
;;aren't permitted. Safe to call on every note creation. Requires no BuildContext
;;so it can run from a background watcher; permission is solicited separately by
;;maybe-prime-reminders.
(defn refresh-streak-reminders [premium? saved-notes]
  (when (and (not kIsWeb) (recent-user?))
    (await (cancel-streak-reminders))
    (when (and (not premium?)
               (not (user-can-claim-premium? saved-notes))
               (await (.isNotificationAllowed (notif/AwesomeNotifications))))
      ;;These have to have different ids, otherwise the last one rewrites the others.
      (doseq [{:keys [id hours title body]} (streak-reminders (consecutive-notes saved-notes))]
        (await
         (.createNotification
          (notif/AwesomeNotifications)

          .content
          (notif/NotificationContent
           .id id
           .channelKey "habit_channel"
           .title title
           .body body
           .wakeUpScreen false
           .category notif/NotificationCategory.Recommendation)

          .schedule
          (notif/NotificationCalendar.fromDate
           .date (.add (DateTime.now) (Duration .hours hours))
           .allowWhileIdle false
           .preciseAlarm false)))))))

;;Soft pre-prompt shown before the OS permission dialog so we ask in context
;;(right after the user has a note and can see the reward), not cold.
(defn prime-notification-dialog [ctx]
  (m/showDialog
   .context ctx
   .builder
   (f/build
    :get [m/Navigator]
    :get {{tthm .-textTheme} m/Theme}
    (m/AlertDialog
     .title (m/Text "Stay on track")
     .content (m/Text (str "Want reminders to help you build a note-taking habit? Keep it going for "
                           streak-goal " days and earn 3 months of premium."))
     .actions
     [(m/TextButton
       .child (m/Text "Not now")
       .onPressed (fn [] (.pop navigator false) nil))
      (m/ElevatedButton
       .child (m/Text "Enable reminders")
       .onPressed (fn [] (.pop navigator true) nil))]))))

;;Shows the pre-prompt once (per device), then requests permission and schedules
;;the first batch of reminders. No-ops if already primed, already allowed, or the
;;user isn't in the reward window. Call from a spot where the home screen is
;;actually visible (a post-frame callback), never mid-navigation.
(defn maybe-prime-reminders [ctx premium? saved-notes]
  (when (and (not kIsWeb)
             (recent-user?)
             (not premium?)
             (>= (count (remove :default saved-notes)) 1)
             ;;This runs from a post-frame callback that can fire while the editor
             ;;is pushed over the home screen — only prompt when home is on top.
             (when-let [route (m/ModalRoute.of ctx)] (.-isCurrent route)))
    (let [prefs (await (sp/SharedPreferences.getInstance))
          primed? (await (.getBool prefs "reminder_primed"))
          allowed? (await (.isNotificationAllowed (notif/AwesomeNotifications)))]
      (when (and (not primed?) (not allowed?))
        (await (.setBool prefs "reminder_primed" true))
        (model/log-analytics "reminder_prompt_shown")
        (if (await (prime-notification-dialog ctx))
          (do
            (model/log-analytics "reminder_prompt_accepted")
            (await (model/request-notification-permission true))
            (await (refresh-streak-reminders premium? saved-notes)))
          (model/log-analytics "reminder_prompt_denied"))))))




